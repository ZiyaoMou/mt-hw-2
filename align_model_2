#!/usr/bin/env python
# -*- coding: utf-8 -*-
import optparse
import sys
from collections import defaultdict
from math import exp

optparser = optparse.OptionParser()
optparser.add_option("-d", "--data", dest="train", default="data/hansards",
                     help="Data filename prefix (default=data)")
optparser.add_option("-e", "--english", dest="english", default="e",
                     help="Suffix of English filename (default=e)")
optparser.add_option("-f", "--french", dest="french", default="f",
                     help="Suffix of French filename (default=f)")
optparser.add_option("-n", "--num_sentences", dest="num_sents", default=100000000000, type="int",
                     help="Number of sentences to use for training and alignment")
# IBM2 (log-linear) hyper-params & training iters
optparser.add_option("-I", "--iterations", dest="iters", default=5, type="int",
                     help="Number of EM iterations for IBM Model 2 (default=5)")
optparser.add_option("-p", "--p0", dest="p0", default=0.08, type="float",
                     help="NULL alignment prior p0 in IBM2 (default=0.08)")
optparser.add_option("-l", "--lambda_param", dest="lmbda", default=4.0, type="float",
                     help="Diagonal tension lambda in IBM2 (default=4.0)")
(opts, _) = optparser.parse_args()

f_data = "%s.%s" % (opts.train, opts.french)
e_data = "%s.%s" % (opts.train, opts.english)

# ADDED: count lines helper
def count_lines(path):
    with open(path, 'r', encoding='utf-8', errors='ignore') as fh:
        return sum(1 for _ in fh)

# ADDED: report input line counts
e_total = count_lines(e_data)
f_total = count_lines(f_data)
sys.stderr.write(f"[info] Input lines — {e_data}: {e_total}, {f_data}: {f_total}\n")
if e_total != f_total:
    sys.stderr.write("[warn] e/f line counts differ; zip() will truncate to the shorter one.\n")

# Load bitext (French=f, English=e)
bitext = [[sentence.strip().split() for sentence in pair]
          for pair in zip(open(f_data, 'r', encoding='utf-8', errors='ignore'),
                          open(e_data, 'r', encoding='utf-8', errors='ignore'))][:opts.num_sents]

# ADDED: report how many sentence pairs will be used
pairs_loaded = len(bitext)
sys.stderr.write(f"[info] Bitext sentence pairs loaded: {pairs_loaded} (limit={opts.num_sents})\n")

# Load bitext (French=f, English=e)
bitext = [[sentence.strip().split() for sentence in pair]
          for pair in zip(open(f_data, 'r', encoding='utf-8', errors='ignore'),
                          open(e_data, 'r', encoding='utf-8', errors='ignore'))][:opts.num_sents]

# ---------- IBM Model 2 (log-linear reparameterization) ----------

NULL = "NULL_TOK"

def h(i, j, m, n):
    """
    Diagonal distance feature from Dyer et al.:
    h(i,j,m,n) = -| j/n - i/m |
    i in [1..m], j in [1..n]; j=0 (NULL) handled separately via p0.
    """
    return -abs((j / float(n)) - (i / float(m))) if n > 0 and m > 0 else 0.0

def delta_nonnull(i, j, m, n, lmbda, Z):
    """
    δ(ai=j | i,m,n) for 1<=j<=n:
      (1-p0) * exp(λ * h(i,j,m,n)) / Z
    Z = sum_{j=1..n} exp(λ*h(i,j,m,n))
    NOTE: we pass Z precomputed for the current (i,m,n).
    """
    return exp(lmbda * h(i, j, m, n)) / Z if Z > 0 else 0.0

# Initialize lexical probs θ(e|f) uniformly over co-occurrences (including NULL)
theta = defaultdict(lambda: defaultdict(float))  # theta[e][f] = P(e|f)

# Build co-occurrence supports: for each sentence pair, any e can come from any f in that sentence (+NULL)
support = defaultdict(set)  # support[f] = set of e's seen with f
for f_sent, e_sent in bitext:
    f_with_null = [NULL] + f_sent
    for f_i in f_with_null:
        for e_j in e_sent:
            support[f_i].add(e_j)

for f_i, e_set in support.items():
    uni = 1.0 / float(len(e_set)) if e_set else 0.0
    for e_j in e_set:
        theta[e_j][f_i] = uni  # uniform init P(e|f)

# EM
lmbda = float(opts.lmbda)
p0 = float(opts.p0)
iters = int(opts.iters)

sys.stderr.write("Training IBM Model 2 (log-linear): iters=%d, p0=%.4f, lambda=%.3f\n" % (iters, p0, lmbda))

for it in range(iters):
    # Expected counts
    c_ef = defaultdict(float)   # counts for (e,f)
    total_f = defaultdict(float)  # total mass for each f

    for f_sent, e_sent in bitext:
        # positions: j over English (target) 1..m, source indices i over 0..n (0 is NULL)
        m = len(e_sent)
        n = len(f_sent)
        if m == 0:
            continue

        # precompute Z_lambda(i,m,n) per i (english index) for non-null j
        # Z = sum_{j=1..n} exp(lmbda * h(i,j,m,n))
        Z_list = []
        for i_pos in range(1, m + 1):
            if n == 0:
                Z_list.append(0.0)
            else:
                Z_list.append(sum(exp(lmbda * h(i_pos, j_pos, m, n)) for j_pos in range(1, n + 1)))

        # collect posterior over alignments for each English position
        for i_pos, e_tok in enumerate(e_sent, start=1):
            # source tokens incl. NULL at index 0
            # weights: w_j ∝ δ(j) * θ(e|f_j)
            # NULL part:
            w_null = p0 * theta[e_tok][NULL]

            # non-null parts:
            if n == 0:
                Z = 0.0
            else:
                Z = Z_list[i_pos - 1]

            w_sum = w_null
            # store temporaries for speed
            w_nonnull = []
            for j_pos, f_tok in enumerate(f_sent, start=1):
                d = (1.0 - p0) * delta_nonnull(i_pos, j_pos, m, n, lmbda, Z)
                w = d * theta[e_tok][f_tok]
                w_nonnull.append((j_pos, f_tok, w))
                w_sum += w

            # Normalize and accumulate expected counts
            if w_sum == 0.0:
                # fallback: split uniformly (rare; can happen early with tiny corpora)
                # give all mass to NULL to stay conservative
                c_ef[(e_tok, NULL)] += 1.0
                total_f[NULL] += 1.0
                continue

            # NULL expected count
            gamma_null = w_null / w_sum
            c_ef[(e_tok, NULL)] += gamma_null
            total_f[NULL] += gamma_null

            # non-null expected counts
            for j_pos, f_tok, w in w_nonnull:
                gamma = w / w_sum
                c_ef[(e_tok, f_tok)] += gamma
                total_f[f_tok] += gamma

    # M-step: θ(e|f) = c(e,f) / sum_e' c(e',f)
    for (e_tok, f_tok), val in c_ef.items():
        # guard against zero totals
        denom = total_f[f_tok] if total_f[f_tok] > 0 else 1.0
        theta[e_tok][f_tok] = val / denom

    sys.stderr.write("  iter %d done\n" % (it + 1))

# Decode: for each English token e_j, pick best source index i* maximizing δ * θ(e_j|f_i)
align_lines = 0  # ADDED

for f_sent, e_sent in bitext:
    m = len(e_sent)
    n = len(f_sent)
    # precompute Z for each english position
    Z_list = []
    for i_pos in range(1, m + 1):
        if n == 0:
            Z_list.append(0.0)
        else:
            Z_list.append(sum(exp(lmbda * h(i_pos, j_pos, m, n)) for j_pos in range(1, n + 1)))

    links = []
    for j_idx, e_tok in enumerate(e_sent, start=1):
        best_score = p0 * theta[e_tok][NULL]  # score for NULL
        best_i = 0
        Z = Z_list[j_idx - 1] if n > 0 else 0.0
        for i_idx, f_tok in enumerate(f_sent, start=1):
            d = (1.0 - p0) * delta_nonnull(j_idx, i_idx, m, n, lmbda, Z)
            score = d * theta[e_tok][f_tok]
            if score > best_score:
                best_score = score
                best_i = i_idx
        if best_i > 0:  # do not output NULL links
            links.append(f"{best_i-1}-{j_idx-1}")  # keep 0-based indices like original
    sys.stdout.write((" ".join(links)) + "\n")
    align_lines += 1  # ADDED

# ADDED: after decoding, report and sanity-check counts
sys.stderr.write(f"[info] Alignment lines written: {align_lines}\n")
if align_lines != pairs_loaded:
    sys.stderr.write(f"[warn] align lines ({align_lines}) != loaded pairs ({pairs_loaded})\n")
else:
    sys.stderr.write("[ok] alignment lines match loaded sentence pairs.\n")